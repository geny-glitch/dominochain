<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ds_bg">

    <LinearLayout
        android:id="@+id/link_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/ds_page_padding"
        android:paddingVertical="@dimen/ds_space_sm"
        android:background="@color/ds_surface"
        android:minHeight="48dp">

        <ImageButton
            android:id="@+id/link_copy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_content_copy"
            android:tint="@color/ds_magenta"
            android:contentDescription="@string/copy"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/link_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:tint="@color/ds_magenta"
            android:contentDescription="@string/share"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/web_url_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/loading"
            style="@style/DsBody"
            android:textColor="@color/ds_teal"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="middle"
            android:paddingHorizontal="@dimen/ds_space_sm"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/link_open"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_open_in_new"
            android:tint="@color/ds_magenta"
            android:contentDescription="@string/open"
            android:scaleType="centerInside" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_page_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_lead"
                style="@style/DsBody"
                android:textColor="@color/ds_text_muted"
                android:layout_marginBottom="@dimen/ds_space_xl" />

            <Button
                android:id="@+id/refresh_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wallpaper_refresh"
                style="@style/DsButton"
                android:layout_marginBottom="@dimen/ds_space_xl" />

            <androidx.cardview.widget.CardView
                android:id="@+id/home_tasks_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_md"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/ds_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_tasks"
                        style="@style/DsSectionTitle"
                        android:layout_marginBottom="@dimen/ds_space_xs" />

                    <TextView
                        android:id="@+id/home_tasks_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tasks_empty"
                        style="@style/DsSmall"
                        android:textColor="@color/ds_text_muted" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
