    <%# Tasks in progress %>
    <section class="ds-beta-section">
      <h2 class="ds-section-title"><%= t("beta.tasks.title") %></h2>
      <% if @tasks.any? %>
        <ul class="ds-task-list">
          <% @tasks.each do |task| %>
            <li class="ds-task-card">
              <div class="ds-task-card-info">
                <span class="ds-task-card-name"><%= task.name %></span>
                <div class="ds-task-card-meta">
                  <%= t("beta.tasks.deadline", datetime: task.deadline_at.strftime("%d/%m %H:%M")) %>
                  · <span class="ds-task-status ds-task-status--<%= task.effective_status %>"><%= task.effective_status %></span>
                  <% if task.proof_pending? %>
                    · <span class="ds-task-status ds-task-status--pending"><%= t("beta.tasks.proof_pending") %></span>
                  <% elsif task.proof_accepted? %>
                    · <span class="ds-task-status ds-task-status--completed"><%= t("beta.tasks.proof_accepted") %></span>
                  <% end %>
                </div>
              </div>
              <div class="ds-task-card-actions">
                <% if task.can_submit_proof? %>
                  <%= link_to t("beta.tasks.submit_proof"), beta_task_path(task), class: "ds-btn ds-btn--primary ds-btn--sm" %>
                <% elsif task.proof_pending? %>
                  <span class="ds-btn ds-btn--ghost ds-btn--sm" disabled><%= t("beta.tasks.awaiting_validation") %></span>
                <% elsif task.proof_accepted? %>
                  <span class="ds-btn ds-btn--ghost ds-btn--sm" disabled><%= t("beta.tasks.validated") %></span>
                <% else %>
                  <span class="ds-btn ds-btn--ghost ds-btn--sm" disabled><%= task.effective_status %></span>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="ds-text-muted"><%= t("beta.empty.no_tasks") %></p>
      <% end %>
    </section>
