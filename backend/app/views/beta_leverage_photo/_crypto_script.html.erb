<script src="/vendor/tlock-js.js"></script>
<script>
  (function () {
    if (window.__leveragePhotoCryptoBound) return;
    window.__leveragePhotoCryptoBound = true;

    const tlock = window.TlockJs;

    function csrfToken() {
      return document.querySelector('meta[name="csrf-token"]')?.content || "";
    }

    function utf8Bytes(str) {
      return new TextEncoder().encode(str);
    }

    function bytesToUtf8(bytes) {
      return new TextDecoder().decode(bytes);
    }

    function isArmoredAge(text) {
      if (typeof text !== "string") return false;
      return text.trimStart().indexOf("-----BEGIN AGE ENCRYPTED FILE-----") === 0;
    }

    async function fetchBytes(url) {
      const res = await fetch(url, {
        credentials: "same-origin",
        headers: { Accept: "application/octet-stream" }
      });
      if (!res.ok) throw new Error("Fetch failed (" + res.status + ")");
      return new Uint8Array(await res.arrayBuffer());
    }

    async function fetchText(url) {
      const res = await fetch(url, {
        credentials: "same-origin",
        headers: { Accept: "text/plain" }
      });
      if (!res.ok) throw new Error("Fetch failed (" + res.status + ")");
      return await res.text();
    }

    function bindPhotoRoot(root) {
      if (root.dataset.cryptoBound === "true") return;
      root.dataset.cryptoBound = "true";

      const statusEl = root.querySelector("[data-crypto-status]");

      function setStatus(message) {
        if (statusEl) statusEl.textContent = message || "";
      }

      function requireTlock() {
        if (!tlock || typeof tlock.timelockEncrypt !== "function") {
          throw new Error(
            statusEl?.dataset.cryptoLoadError || "Crypto library is not available"
          );
        }
        return tlock;
      }

      const UNIT_SECONDS = {
        years: 365 * 86400,
        months: 30 * 86400,
        weeks: 7 * 86400,
        days: 86400,
        hours: 3600,
        minutes: 60
      };
      const MAX_SECONDS = 365 * 86400;
      const DAY_SECONDS = 86400;

      function unitSeconds(unit) {
        return UNIT_SECONDS[unit] || DAY_SECONDS;
      }

      function maxAmountFor(unit) {
        return Math.max(1, Math.floor(MAX_SECONDS / unitSeconds(unit)));
      }

      function bindDurationPicker(picker) {
        const input = picker.querySelector("input[type='number']");
        const unitSelect = picker.querySelector("[data-duration-unit]");
        if (!input || !unitSelect) return;

        function syncMax() {
          input.max = String(maxAmountFor(unitSelect.value));
        }

        function setSeconds(seconds) {
          const amount = Math.max(1, Math.round(seconds / unitSeconds(unitSelect.value)));
          input.value = String(Math.min(amount, maxAmountFor(unitSelect.value)));
        }

        unitSelect.addEventListener("change", function () {
          const prev = unitSelect.getAttribute("data-previous-unit") || "days";
          const seconds = parseInt(input.value, 10) * unitSeconds(prev);
          unitSelect.setAttribute("data-previous-unit", unitSelect.value);
          syncMax();
          if (Number.isFinite(seconds) && seconds > 0) setSeconds(seconds);
        });

        syncMax();
        unitSelect.setAttribute("data-previous-unit", unitSelect.value);
      }

      function readDurationSeconds(selector, fallbackSeconds) {
        const input = root.querySelector(selector);
        const picker = input && input.closest(".ds-beta-leverage-duration");
        const unitSelect = picker && picker.querySelector("[data-duration-unit]");
        const raw = parseInt(input && input.value ? input.value : "", 10);
        const fallback = fallbackSeconds || DAY_SECONDS;

        if (unitSelect) {
          const amount = Number.isFinite(raw) && raw >= 1
            ? raw
            : Math.max(1, Math.round(fallback / unitSeconds(unitSelect.value)));
          const seconds = amount * unitSeconds(unitSelect.value);
          if (seconds < 60) {
            throw new Error(root.dataset.invalidMinutes || "Enter at least 1 minute.");
          }
          if (seconds > MAX_SECONDS) {
            throw new Error(root.dataset.invalidMinutesMax || "Duration is too long.");
          }
          return seconds;
        }

        const minutes = Number.isFinite(raw) && raw >= 1 ? raw : Math.round(fallback / 60);
        if (!Number.isFinite(minutes) || minutes < 1) {
          throw new Error(root.dataset.invalidMinutes || "Enter at least 1 minute.");
        }
        if (minutes > Math.floor(MAX_SECONDS / 60)) {
          throw new Error(root.dataset.invalidMinutesMax || "Duration is too long.");
        }
        return minutes * 60;
      }

      async function encryptPayload(bytesOrString, lockedUntil) {
        const api = requireTlock();
        const client = api.mainnetClient();
        const chainInfo = api.defaultChainInfo || (await client.chain().info());
        const round = api.roundAt(lockedUntil.getTime(), chainInfo);
        if (!Number.isFinite(round) || round < 1) {
          throw new Error("Invalid drand round for selected duration");
        }
        const payload =
          typeof bytesOrString === "string" ? utf8Bytes(bytesOrString) : bytesOrString;
        const armored = await api.timelockEncrypt(
          round,
          api.Buffer.from(payload),
          client
        );
        return { armored: armored, round: round, chainHash: chainInfo.hash };
      }

      function peelLayerLimit() {
        const fromDom = parseInt(root.dataset.maxPeelLayers || "", 10);
        const recorded = parseInt(root.dataset.layerCount || "", 10);
        const cap = Number.isFinite(fromDom) && fromDom > 0 ? fromDom : 64;
        const expected = Number.isFinite(recorded) && recorded > 0 ? recorded : 0;
        return Math.max(expected, cap);
      }

      function displayCryptoError(err) {
        const msg = err && err.message ? err.message : String(err);
        if (msg === "RESTORE_LAYER_LIMIT") {
          return statusEl?.dataset.peelError || statusEl?.dataset.cryptoLoadError || msg;
        }
        return msg;
      }

      async function peelLayers(outerArmored) {
        const api = requireTlock();
        const client = api.mainnetClient();
        let payload = outerArmored;
        let layersPeeled = 0;
        const max = peelLayerLimit();
        while (layersPeeled < max) {
          const decrypted = await api.timelockDecrypt(payload, client);
          layersPeeled += 1;
          const asText = bytesToUtf8(decrypted);
          if (isArmoredAge(asText)) {
            payload = asText;
            continue;
          }
          return { bytes: decrypted, layersPeeled: layersPeeled };
        }
        throw new Error("RESTORE_LAYER_LIMIT");
      }

      async function peelOriginalBytes() {
        setStatus(statusEl?.dataset.fetchingBlob || "Loading locked photo…");
        const armored = await fetchText(root.dataset.decryptUrl);
        setStatus(statusEl?.dataset.peeling || "Restoring…");
        const peeled = await peelLayers(armored);
        return peeled.bytes;
      }

      async function resolveOriginalBytes() {
        if (root.dataset.hasOriginal === "true") {
          setStatus(statusEl?.dataset.fetchingOriginal || "Loading photo…");
          return fetchBytes(root.dataset.originalUrl);
        }
        if (root.dataset.photoStatus === "unlocked") {
          return peelOriginalBytes();
        }
        setStatus(statusEl?.dataset.fetchingOriginal || "Loading photo…");
        return fetchBytes(root.dataset.originalUrl);
      }

      async function persistRestoredOriginal(bytes) {
        if (!root.dataset.restoreUrl) return;
        const filename = root.dataset.originalFilename || "photo.jpg";
        const formData = new FormData();
        formData.append(
          "original_image",
          new Blob([bytes], { type: "image/jpeg" }),
          filename
        );
        setStatus(statusEl?.dataset.uploading || "Saving…");
        const res = await fetch(root.dataset.restoreUrl, {
          method: "POST",
          body: formData,
          credentials: "same-origin",
          headers: {
            "X-CSRF-Token": csrfToken(),
            Accept: "application/json"
          }
        });
        const data = await res.json().catch(function () { return {}; });
        if (!res.ok) throw new Error(data.error || "Restore failed");
      }

      async function startTimer(durationSeconds) {
        requireTlock();
        const lockedUntil = new Date(Date.now() + durationSeconds * 1000);
        const originalBytes = await resolveOriginalBytes();
        setStatus(statusEl?.dataset.encrypting || "Encrypting…");
        const result = await encryptPayload(originalBytes, lockedUntil);

        const formData = new FormData();
        formData.append(
          "tlock_blob",
          new Blob([result.armored], { type: "text/plain" }),
          "layer.tlock"
        );
        formData.append("drand_round", String(result.round));
        formData.append("drand_chain_hash", result.chainHash || "");
        formData.append("duration_seconds", String(durationSeconds));
        formData.append("locked_until", lockedUntil.toISOString());

        setStatus(statusEl?.dataset.uploading || "Uploading…");
        const res = await fetch(root.dataset.startUrl, {
          method: "POST",
          body: formData,
          credentials: "same-origin",
          headers: {
            "X-CSRF-Token": csrfToken(),
            Accept: "application/json"
          }
        });
        const data = await res.json().catch(function () { return {}; });
        if (!res.ok) throw new Error(data.error || "Start timer failed");
        return data;
      }

      async function addTime(addedSeconds, options) {
        options = options || {};
        requireTlock();
        const base = root.dataset.lockedUntil
          ? new Date(root.dataset.lockedUntil)
          : new Date();
        const from = base.getTime() > Date.now() ? base : new Date();
        const lockedUntil = new Date(from.getTime() + addedSeconds * 1000);

        setStatus(statusEl?.dataset.fetchingBlob || "Fetching lock blob…");
        const currentArmored = await fetchText(root.dataset.tlockUrl);
        setStatus(statusEl?.dataset.encrypting || "Encrypting…");
        const result = await encryptPayload(currentArmored, lockedUntil);

        const formData = new FormData();
        formData.append(
          "tlock_blob",
          new Blob([result.armored], { type: "text/plain" }),
          "layer.tlock"
        );
        formData.append("drand_round", String(result.round));
        formData.append("added_seconds", String(addedSeconds));
        formData.append("locked_until", lockedUntil.toISOString());
        if (options.saveAsBase) formData.append("save_as_base", "true");
        if (options.applyNextStep) formData.append("apply_next_step", "true");

        setStatus(statusEl?.dataset.uploading || "Uploading…");
        const res = await fetch(root.dataset.addTimeUrl, {
          method: "POST",
          body: formData,
          credentials: "same-origin",
          headers: {
            "X-CSRF-Token": csrfToken(),
            Accept: "application/json"
          }
        });
        const data = await res.json().catch(function () { return {}; });
        if (!res.ok) throw new Error(data.error || "Add time failed");
        return data;
      }

      async function decryptAndDisplay() {
        requireTlock();
        setStatus(statusEl?.dataset.peeling || "Unlocking…");
        const armored = await fetchText(root.dataset.decryptUrl);
        const peeled = await peelLayers(armored);
        await persistRestoredOriginal(peeled.bytes);
        window.location.reload();
      }

      root.querySelectorAll(".ds-beta-leverage-duration").forEach(bindDurationPicker);

      const startBtn = root.querySelector("[data-action='start-timer']");
      if (startBtn) {
        startBtn.addEventListener("click", async function () {
          startBtn.disabled = true;
          setStatus(statusEl?.dataset.starting || "Starting…");
          try {
            const durationSeconds = readDurationSeconds("[data-duration-minutes]", DAY_SECONDS);
            await startTimer(durationSeconds);
            window.location.reload();
          } catch (err) {
            console.error("[leverage_photo] start failed", err);
            setStatus(displayCryptoError(err));
            startBtn.disabled = false;
          }
        });
      }

      function saveAsBaseChecked() {
        const checkbox = root.querySelector("[data-save-as-base]");
        return Boolean(checkbox && checkbox.checked);
      }

      function pickerDurationLabel() {
        const input = root.querySelector("[data-add-minutes]");
        const unitSelect = root.querySelector("[data-duration-unit]");
        const amount = input && input.value ? input.value : "1";
        const unitText = unitSelect && unitSelect.selectedOptions[0]
          ? unitSelect.selectedOptions[0].textContent.trim()
          : "";
        return (amount + " " + unitText).trim();
      }

      function fillStepLabel(template, n, duration) {
        return template.replace("%{n}", String(n)).replace("%{duration}", duration);
      }

      function updateStepButton() {
        const stepBtn = root.querySelector("[data-action='add-time-step']");
        if (!stepBtn) return;
        const template = stepBtn.dataset.labelTemplate || "";
        const storedBase = parseInt(stepBtn.dataset.baseSeconds || "0", 10);
        const storedN = parseInt(stepBtn.dataset.stepN || "0", 10);
        if (saveAsBaseChecked() || !storedBase) {
          stepBtn.textContent = fillStepLabel(template, 1, pickerDurationLabel());
        } else {
          stepBtn.textContent = fillStepLabel(template, storedN + 1, stepBtn.dataset.baseLabel || pickerDurationLabel());
        }
      }

      const addBtn = root.querySelector("[data-action='add-time']");
      const stepBtn = root.querySelector("[data-action='add-time-step']");

      function setAddButtonsDisabled(disabled) {
        if (addBtn) addBtn.disabled = disabled;
        if (stepBtn) stepBtn.disabled = disabled;
      }

      if (addBtn) {
        addBtn.addEventListener("click", async function () {
          setAddButtonsDisabled(true);
          setStatus(statusEl?.dataset.adding || "Adding time…");
          try {
            const addedSeconds = readDurationSeconds("[data-add-minutes]", DAY_SECONDS);
            await addTime(addedSeconds, { saveAsBase: saveAsBaseChecked() });
            window.location.reload();
          } catch (err) {
            console.error("[leverage_photo] add_time failed", err);
            setStatus(displayCryptoError(err));
            setAddButtonsDisabled(false);
          }
        });
      }

      if (stepBtn) {
        stepBtn.addEventListener("click", async function () {
          setAddButtonsDisabled(true);
          setStatus(statusEl?.dataset.adding || "Adding time…");
          try {
            const storedBase = parseInt(stepBtn.dataset.baseSeconds || "0", 10);
            const storedN = parseInt(stepBtn.dataset.stepN || "0", 10);
            const resetBase = saveAsBaseChecked() || !storedBase;
            const addedSeconds = resetBase
              ? readDurationSeconds("[data-add-minutes]", DAY_SECONDS)
              : (storedN + 1) * storedBase;
            if (!Number.isFinite(addedSeconds) || addedSeconds < 60) {
              throw new Error(root.dataset.invalidMinutes || "Enter at least 1 minute.");
            }
            if (addedSeconds > MAX_SECONDS) {
              throw new Error(root.dataset.invalidMinutesMax || "Duration is too long.");
            }
            await addTime(addedSeconds, { saveAsBase: resetBase, applyNextStep: true });
            window.location.reload();
          } catch (err) {
            console.error("[leverage_photo] add_time_step failed", err);
            setStatus(displayCryptoError(err));
            setAddButtonsDisabled(false);
          }
        });
      }

      const saveAsBase = root.querySelector("[data-save-as-base]");
      const addAmountInput = root.querySelector("[data-add-minutes]");
      const addUnitSelect = root.querySelector("[data-duration-unit]");
      if (saveAsBase) saveAsBase.addEventListener("change", updateStepButton);
      if (addAmountInput) addAmountInput.addEventListener("input", updateStepButton);
      if (addUnitSelect) addUnitSelect.addEventListener("change", updateStepButton);
      updateStepButton();

      const decryptBtn = root.querySelector("[data-action='decrypt']");
      if (decryptBtn) {
        decryptBtn.addEventListener("click", async function () {
          decryptBtn.disabled = true;
          try {
            await decryptAndDisplay();
          } catch (err) {
            console.error("[leverage_photo] decrypt failed", err);
            setStatus(displayCryptoError(err));
            decryptBtn.disabled = false;
          }
        });
      }

      const countdown = root.querySelector("[data-countdown]");
      if (countdown && root.dataset.lockedUntil) {
        const end = new Date(root.dataset.lockedUntil).getTime();
        const tick = function () {
          const remaining = Math.max(0, end - Date.now());
          const s = Math.floor(remaining / 1000);
          const d = Math.floor(s / 86400);
          const h = Math.floor((s % 86400) / 3600);
          const m = Math.floor((s % 3600) / 60);
          const sec = s % 60;
          countdown.textContent =
            d > 0
              ? d + "d " + h + "h " + m + "m"
              : h > 0
                ? h + "h " + m + "m " + sec + "s"
                : m + "m " + sec + "s";
          if (remaining <= 0) countdown.textContent = countdown.dataset.ready || "Ready";
        };
        tick();
        setInterval(tick, 1000);
      }
    }

    document.querySelectorAll("[data-leverage-photo]").forEach(bindPhotoRoot);
  })();
</script>
