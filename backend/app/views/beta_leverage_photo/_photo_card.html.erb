<%# locals: photo, compact: false %>
<% compact = local_assigns.fetch(:compact, false) %>
<% if compact %>
  <%= render "beta_leverage_photo/photo_row", photo: photo %>
<% else %>
  <% mates = photo.bundle_mates %>
  <% timer_photo = photo.timer_photo || photo %>
  <% id_prefix = "lp-#{timer_photo.id}" %>
  <div class="ds-beta-control-card ds-beta-leverage-show-card"
       data-leverage-photo
       data-original-url="<%= beta_leverage_photo_original_path(timer_photo) %>"
       data-start-url="<%= beta_leverage_photo_start_path(timer_photo) %>"
       data-tlock-url="<%= beta_leverage_photo_tlock_blob_path(timer_photo) %>"
       data-add-time-url="<%= beta_leverage_photo_add_time_path(timer_photo) %>"
       data-decrypt-url="<%= beta_leverage_photo_decrypt_payload_path(timer_photo) %>"
       data-restore-url="<%= beta_leverage_photo_restore_original_path(timer_photo) %>"
       data-original-filename="<%= timer_photo.download_filename %>"
       data-photo-status="<%= timer_photo.status %>"
       data-tlock-format="<%= timer_photo.tlock_format %>"
       data-has-original="<%= timer_photo.original_image.attached? ? "true" : "false" %>"
       data-locked-until="<%= timer_photo.locked_until&.iso8601 %>"
       data-layer-count="<%= timer_photo.tlock_layer_count %>"
       data-max-peel-layers="<%= LeveragePhoto::MAX_PEEL_LAYERS %>"
       data-invalid-minutes="<%= t("leverage_photo.show.invalid_minutes") %>"
       data-invalid-minutes-max="<%= t("leverage_photo.show.invalid_minutes_max") %>">
    <div class="ds-beta-home-card-head">
      <h2 class="ds-section-title"><%= t("leverage_photo.show.status_title") %></h2>
      <span class="ds-beta-home-pill <%= timer_photo.active? ? "ds-beta-home-pill--on" : "" %>">
        <%= t("leverage_photo.status.#{timer_photo.status}") %>
      </span>
    </div>

    <% if timer_photo.unlocked? %>
      <%= render "beta_leverage_photo/time_lock_panel", photo: timer_photo, id_prefix: id_prefix, mode: :relock %>
    <% elsif timer_photo.draft? %>
      <%= render "beta_leverage_photo/time_lock_panel", photo: timer_photo, id_prefix: id_prefix, mode: :start %>
    <% elsif timer_photo.active? %>
      <%= render "beta_leverage_photo/time_lock_panel", photo: timer_photo, id_prefix: id_prefix, mode: :add_time %>
    <% end %>

    <p class="ds-beta-home-muted ds-beta-leverage-crypto-status" data-crypto-status
       data-starting="<%= t("leverage_photo.show.status_starting") %>"
       data-adding="<%= t("leverage_photo.show.status_adding") %>"
       data-peeling="<%= t("leverage_photo.show.status_peeling") %>"
       data-loading-crypto="<%= t("leverage_photo.show.status_loading_crypto") %>"
       data-crypto-load-error="<%= t("leverage_photo.show.status_crypto_load_error") %>"
       data-peel-error="<%= t("leverage_photo.show.status_peel_error") %>"
       data-fetching-original="<%= t("leverage_photo.show.status_fetching_original") %>"
       data-fetching-blob="<%= t("leverage_photo.show.status_fetching_blob") %>"
       data-encrypting="<%= t("leverage_photo.show.status_encrypting") %>"
       data-uploading="<%= t("leverage_photo.show.status_uploading") %>"
       aria-live="polite"></p>
  </div>

  <div class="ds-beta-leverage-members">
    <% mates.each do |member| %>
      <%= render "beta_leverage_photo/photo_member", photo: member %>
    <% end %>
  </div>
<% end %>
