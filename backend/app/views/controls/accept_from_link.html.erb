<div class="ds-page">
  <div class="ds-container">
    <h1><%= t("controls.from_link_title", nickname: @beta.nickname) %></h1>
    <p><%= t("controls.from_link_lead") %></p>
    <%= button_to t("dashboard.accept"), control_accept_from_link_submit_path(@nickname), method: :post, class: "ds-btn ds-btn--primary" %>
